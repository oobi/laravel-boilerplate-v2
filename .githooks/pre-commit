#!/bin/sh
# Formats staged PHP files with Pint, then runs the fast suite. Bypass with
# `git commit --no-verify`.
#
# The fast suite (`composer test:fast`) is the full suite minus the `slow`
# group, in parallel, so it takes seconds. Commits that touch no PHP skip both
# steps. The full suite, slow group included, still runs in .githooks/pre-push.

. "$(dirname "$0")/php-path.sh"
require_php

STAGED_PHP_FILES=$(git diff --cached --name-only --diff-filter=ACMR -- '*.php')

if [ -z "$STAGED_PHP_FILES" ]; then
    exit 0
fi

echo "Running Pint on staged PHP files..."
echo "$STAGED_PHP_FILES" | xargs vendor/bin/pint

if [ $? -ne 0 ]; then
    echo ""
    echo "Commit aborted: Pint failed. Fix the errors above."
    exit 1
fi

# Re-stage any files Pint reformatted so the fixes are included in the commit.
echo "$STAGED_PHP_FILES" | xargs git add

echo "Running the fast test suite..."
composer test:fast

if [ $? -ne 0 ]; then
    echo ""
    echo "Commit aborted: tests failed. Fix the failures or use --no-verify to skip this check."
    exit 1
fi

exit 0
