#!/bin/sh
# Formats staged PHP files with Pint. Bypass with `git commit --no-verify`.
#
# Deliberately fast: the test suite runs in .githooks/pre-push, not here, so
# committing stays cheap and you can commit as often as you like. Nothing
# broken reaches a remote — push is the gate, commit is not.

. "$(dirname "$0")/php-path.sh"
require_php

STAGED_PHP_FILES=$(git diff --cached --name-only --diff-filter=ACMR -- '*.php')

if [ -z "$STAGED_PHP_FILES" ]; then
    exit 0
fi

echo "Running Pint on staged PHP files..."
echo "$STAGED_PHP_FILES" | xargs vendor/bin/pint

if [ $? -ne 0 ]; then
    echo ""
    echo "Commit aborted: Pint failed. Fix the errors above."
    exit 1
fi

# Re-stage any files Pint reformatted so the fixes are included in the commit.
echo "$STAGED_PHP_FILES" | xargs git add

exit 0
