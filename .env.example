# ---- App ------------------------------------------------------------------
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Also controls the Debugbar (barryvdh/laravel-debugbar): keep true locally,
# always false in staging/production.
APP_DEBUG=true
APP_URL=http://localhost:8000

# Leave unset to auto-follow APP_DEBUG (barryvdh/laravel-debugbar default)
# DEBUGBAR_ENABLED=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ---- Logging ----------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Database -----------------------------------------------------------
# sqlite needs no service running; `composer setup`/`create-project` auto-
# creates database/database.sqlite. Uncomment below + set DB_CONNECTION=mysql
# (or mariadb/pgsql/sqlsrv) to use a real database server instead.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ---- Session --------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ---- Cache ------------------------------------------------------------
CACHE_STORE=database
# CACHE_PREFIX=

# Only used if a cache/session/queue driver above is switched to "memcached".
MEMCACHED_HOST=127.0.0.1

# Only used if a cache/session/queue driver above is switched to "redis".
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Mail -------------------------------------------------------------
# "log" writes mail to storage/logs instead of sending — safe zero-config
# local default. Switch to "smtp" (e.g. Mailpit on port 1025) to preview
# real emails locally.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- AWS (S3 filesystem disk / SES mail driver) ----------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---- Auth -----------------------------------------------------------------
# Where a user with no system role and no team lands after login: home (public
# landing page) | reject (log back out with a "contact an admin" notice — for a
# login-only backoffice with no public page).
# LOGIN_FALLBACK=home

# ---- Teams tier (packages/teams) ----------------------------------------
# The project's words for the tier's three domain nouns — a team, someone who
# belongs to one, someone who owns one. Each relabels the whole UI (headings,
# buttons, emails, seeded default role names) without renaming any class or
# table; e.g. Salon / Stylist / Manager. Set singular + plural together.
# TEAMS_LABEL_SINGULAR=Team
# TEAMS_LABEL_PLURAL=Teams
# TEAMS_MEMBER_LABEL_SINGULAR=Member
# TEAMS_MEMBER_LABEL_PLURAL=Members
# TEAMS_OWNER_LABEL_SINGULAR=Owner
# TEAMS_OWNER_LABEL_PLURAL=Owners
# The URL segment for team routes (/{prefix}/{team-slug}); relabel alongside the words above.
# TEAMS_ROUTE_PREFIX=teams
# Who may create a team: self-service (any user) | admin-only (admins only, via Admin › Teams)
# TEAMS_CREATION=self-service
# Role a new team's owner is given at setup. Ownership is a shield (other members can't
# remove/demote an owner) + responsibility anchor, never a permission bypass — the owner's
# authority comes from this role, like any member. Unset = the seeded "{Team} Admin" role.
# TEAMS_DEFAULT_OWNER_ROLE=
# Whether a team's owner may delete their own team (default true). Off reserves deletion to
# system admins — for platforms that provision and own the teams (backoffice, franchise).
# TEAMS_OWNER_CAN_DELETE=true
# Whether email invitations are available, and to whom (both default on; off = admins add members directly)
# TEAMS_MEMBER_INVITATIONS=true
# TEAMS_ADMIN_INVITATIONS=true
# How many teams one user may own under self-service (unset = unlimited)
# TEAMS_MAX_PER_USER=
# Whether a member may hold several team roles at once (default: one, a "position")
# TEAMS_MULTIPLE_ROLES=false
# Give every user a personal team on registration (default off; onboarding handles the empty state)
# TEAMS_PERSONAL_TEAMS=false
# Turn on the custom-domain overlay (default off). A setup-time/per-environment decision,
# not a live flip: on = teams reached by host ({slug}.{base} + verified custom domains).
# TEAMS_DOMAINS_ENABLED=false
# Base disk for per-team isolated storage (teams/{id}/ prefix on it)
# TEAMS_FILESYSTEM_DISK=local

# ---- Frontend build ---------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
